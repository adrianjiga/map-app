{
  "name": "map-app",
  "version": "1.0.0",
  "private": true,
  "description": "A workout tracker that logs running and cycling sessions on an interactive Leaflet map.",
  "license": "MIT",
  "author": "Adrian Jiga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianjiga/map-app.git"
  },
  "homepage": "https://adrianjiga.github.io/map-app/",
  "bugs": {
    "url": "https://github.com/adrianjiga/map-app/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
